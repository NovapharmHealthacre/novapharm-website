# syntax=docker/dockerfile:1
# Four PUBLIC AWS managed-app image candidates. No DNS, customer data or release activation.
# APP is allowlisted below. The API and protected customer portal require separate
# identity, network, database and security contracts before any launch.
FROM node:24-trixie-slim AS builder
ARG APP
WORKDIR /workspace
RUN case "$APP" in corporate|founder|technology|status) ;; *) echo "Unsupported managed public app" >&2; exit 1 ;; esac
COPY . .
RUN npm ci --ignore-scripts
RUN npm run build --workspace="@novapharm/${APP}"

FROM node:24-trixie-slim AS runtime
ARG APP
ARG SOURCE_SHA
RUN case "$APP" in corporate|founder|technology|status) ;; *) echo "Unsupported managed public app" >&2; exit 1 ;; esac
RUN printf '%s' "$SOURCE_SHA" | grep -Eq '^[0-9a-f]{40}$'
RUN apt-get update && apt-get install --only-upgrade -y zlib1g && rm -rf /var/lib/apt/lists/*
LABEL org.opencontainers.image.title="NovaPharm managed public application candidate" \
      org.opencontainers.image.revision="${SOURCE_SHA}" \
      novapharm.release-gate="nonproduction-candidate-not-approved"
ENV NODE_ENV=production \
    HOSTNAME=0.0.0.0 \
    PORT=4300 \
    NOVAPHARM_MANAGED_APP="${APP}"
WORKDIR /app
COPY --from=builder --chown=node:node /workspace/apps/${APP}/.next/standalone/ /app/
RUN test -f "/app/apps/${APP}/server.js"
USER node
EXPOSE 4300
# Liveness only. A response from the app is NOT proof of business readiness or
# approval of customer access, regulated operations, data or publication.
HEALTHCHECK --interval=30s --timeout=5s --start-period=60s --retries=3 \
  CMD node -e "fetch('http://127.0.0.1:4300/').then(r=>{if(r.status<200||r.status>=400)process.exit(1)}).catch(()=>process.exit(1))"
CMD ["sh", "-c", "exec node apps/${NOVAPHARM_MANAGED_APP}/server.js"]
