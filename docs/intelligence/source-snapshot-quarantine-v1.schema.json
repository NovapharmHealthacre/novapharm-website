{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://novapharmhealthcare.com/schemas/intelligence/source-snapshot-quarantine-v1.json",
  "title": "NovaPharm Intelligence bounded source-snapshot quarantine v1",
  "description": "Unreleased metadata-only internal sample manifest, never a rights grant or a customer delivery permission.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract",
    "snapshotId",
    "sourceKey",
    "jurisdiction",
    "publisher",
    "datasetKey",
    "resourceId",
    "resourceUrl",
    "mediaType",
    "schemaVersion",
    "observationStart",
    "observationEnd",
    "publishedOn",
    "fetchedAt",
    "sampleBytes",
    "digestSha256",
    "sourceRightsIndependentlyApproved",
    "rightsEvidenceId",
    "intakeState",
    "productionAccepted",
    "canPublish",
    "commercialDecisionReady",
    "clinicalDecisionReady"
  ],
  "properties": {
    "contract": {
      "const": "novapharm.intelligence.source-quarantine.v1"
    },
    "snapshotId": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "sourceKey": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]{2,119}$"
    },
    "jurisdiction": {
      "type": "string",
      "pattern": "^(GLOBAL|[A-Z]{2}(-[A-Z0-9]{2,5})?)$"
    },
    "publisher": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160
    },
    "datasetKey": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]{2,119}$"
    },
    "resourceId": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]{2,119}$"
    },
    "resourceUrl": {
      "type": "string",
      "format": "uri",
      "pattern": "^https://"
    },
    "mediaType": {
      "enum": [
        "application/json",
        "text/csv",
        "application/xml",
        "text/xml",
        "application/ld+json",
        "application/x-ndjson",
        "text/plain"
      ]
    },
    "schemaVersion": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]{2,119}$"
    },
    "observationStart": {
      "type": "string",
      "format": "date"
    },
    "observationEnd": {
      "type": "string",
      "format": "date"
    },
    "publishedOn": {
      "type": "string",
      "format": "date"
    },
    "fetchedAt": {
      "type": "string",
      "format": "date-time"
    },
    "sampleBytes": {
      "type": "integer",
      "minimum": 1,
      "maximum": 262144
    },
    "digestSha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "sourceRightsIndependentlyApproved": {
      "const": false
    },
    "rightsEvidenceId": {
      "const": null
    },
    "intakeState": {
      "const": "QUARANTINED_INTERNAL_EVALUATION"
    },
    "productionAccepted": {
      "const": false
    },
    "canPublish": {
      "const": false
    },
    "commercialDecisionReady": {
      "const": false
    },
    "clinicalDecisionReady": {
      "const": false
    }
  }
}
