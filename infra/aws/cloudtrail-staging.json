{
  "AWSTemplateFormatVersion": "2010-09-09",
  "Description": "NovaPharm AWS new-experience eu-north-1 staging only, first management-event CloudTrail copy to encrypted S3. No data events or Lake.",
  "Parameters": {
    "Environment": {
      "Type": "String",
      "Default": "staging",
      "AllowedValues": [
        "staging"
      ]
    }
  },
  "Rules": {
    "RegionLock": {
      "Assertions": [
        {
          "Assert": {
            "Fn::Equals": [
              {
                "Ref": "AWS::Region"
              },
              "eu-north-1"
            ]
          },
          "AssertDescription": "Single-Region staging audit only."
        }
      ]
    }
  },
  "Resources": {
    "AuditBucket": {
      "Type": "AWS::S3::Bucket",
      "DeletionPolicy": "Retain",
      "UpdateReplacePolicy": "Retain",
      "Properties": {
        "BucketName": "novapharm-staging-cloudtrail-250675045172-eu-north-1",
        "PublicAccessBlockConfiguration": {
          "BlockPublicAcls": true,
          "BlockPublicPolicy": true,
          "IgnorePublicAcls": true,
          "RestrictPublicBuckets": true
        },
        "BucketEncryption": {
          "ServerSideEncryptionConfiguration": [
            {
              "ServerSideEncryptionByDefault": {
                "SSEAlgorithm": "AES256"
              }
            }
          ]
        },
        "VersioningConfiguration": {
          "Status": "Enabled"
        },
        "OwnershipControls": {
          "Rules": [
            {
              "ObjectOwnership": "BucketOwnerEnforced"
            }
          ]
        },
        "LifecycleConfiguration": {
          "Rules": [
            {
              "Id": "staging-management-evidence-365d",
              "Status": "Enabled",
              "ExpirationInDays": 365,
              "NoncurrentVersionExpiration": {
                "NoncurrentDays": 365
              }
            }
          ]
        },
        "Tags": [
          {
            "Key": "application",
            "Value": "novapharm"
          },
          {
            "Key": "environment",
            "Value": "staging"
          },
          {
            "Key": "classification",
            "Value": "security-management-metadata"
          }
        ]
      }
    },
    "AuditBucketPolicy": {
      "Type": "AWS::S3::BucketPolicy",
      "Properties": {
        "Bucket": {
          "Ref": "AuditBucket"
        },
        "PolicyDocument": {
          "Version": "2012-10-17",
          "Statement": [
            {
              "Sid": "DenyInsecureTransport",
              "Effect": "Deny",
              "Principal": "*",
              "Action": "s3:*",
              "Resource": [
                {
                  "Fn::GetAtt": [
                    "AuditBucket",
                    "Arn"
                  ]
                },
                {
                  "Fn::Sub": "${AuditBucket.Arn}/*"
                }
              ],
              "Condition": {
                "Bool": {
                  "aws:SecureTransport": "false"
                }
              }
            },
            {
              "Sid": "AllowCloudTrailAclCheck",
              "Effect": "Allow",
              "Principal": {
                "Service": "cloudtrail.amazonaws.com"
              },
              "Action": "s3:GetBucketAcl",
              "Resource": {
                "Fn::GetAtt": [
                  "AuditBucket",
                  "Arn"
                ]
              },
              "Condition": {
                "StringEquals": {
                  "aws:SourceArn": {
                    "Fn::Sub": "arn:${AWS::Partition}:cloudtrail:${AWS::Region}:${AWS::AccountId}:trail/novapharm-staging-audit"
                  }
                }
              }
            },
            {
              "Sid": "AllowCloudTrailWriteOnly",
              "Effect": "Allow",
              "Principal": {
                "Service": "cloudtrail.amazonaws.com"
              },
              "Action": "s3:PutObject",
              "Resource": {
                "Fn::Sub": "${AuditBucket.Arn}/AWSLogs/${AWS::AccountId}/*"
              },
              "Condition": {
                "StringEquals": {
                  "s3:x-amz-acl": "bucket-owner-full-control",
                  "aws:SourceArn": {
                    "Fn::Sub": "arn:${AWS::Partition}:cloudtrail:${AWS::Region}:${AWS::AccountId}:trail/novapharm-staging-audit"
                  }
                }
              }
            }
          ]
        }
      }
    },
    "AuditTrail": {
      "Type": "AWS::CloudTrail::Trail",
      "DependsOn": "AuditBucketPolicy",
      "Properties": {
        "TrailName": "novapharm-staging-audit",
        "S3BucketName": {
          "Ref": "AuditBucket"
        },
        "IsLogging": true,
        "IsMultiRegionTrail": false,
        "IncludeGlobalServiceEvents": false,
        "EnableLogFileValidation": true,
        "EventSelectors": [
          {
            "IncludeManagementEvents": true,
            "ReadWriteType": "All",
            "DataResources": []
          }
        ],
        "Tags": [
          {
            "Key": "application",
            "Value": "novapharm"
          },
          {
            "Key": "environment",
            "Value": "staging"
          },
          {
            "Key": "cost-scope",
            "Value": "first-copy-management-events-only"
          }
        ]
      }
    }
  },
  "Outputs": {
    "TrailArn": {
      "Value": {
        "Fn::GetAtt": [
          "AuditTrail",
          "Arn"
        ]
      }
    },
    "AuditBucket": {
      "Value": {
        "Ref": "AuditBucket"
      }
    }
  }
}
