{
  "AWSTemplateFormatVersion": "2010-09-09",
  "Description": "NovaPharm Intelligence separate, approval-gated ALB/WAF/ECS production ingress candidate. NO deployable resources until ActivationApproval=APPROVED. Never reuses the Nutraxin customer portal.",
  "Parameters": {
    "ActivationApproval": {
      "Type": "String",
      "Default": "BLOCKED",
      "AllowedValues": [
        "BLOCKED",
        "APPROVED"
      ],
      "Description": "Must be approved after ACM issuance, identity/MFA, real secrets, approved data rights, rollback, cost and signed production acceptance"
    },
    "VpcId": {
      "Type": "AWS::EC2::VPC::Id"
    },
    "PublicSubnetIds": {
      "Type": "List<AWS::EC2::Subnet::Id>",
      "Description": "Two or more AZ-diverse public subnets for public TLS ALB"
    },
    "PrivateSubnetIds": {
      "Type": "List<AWS::EC2::Subnet::Id>",
      "Description": "Two or more AZ-diverse private subnets; VPC endpoints or NAT for ECR/CloudWatch/OIDC and API must already exist"
    },
    "IssuedCertificateArn": {
      "Type": "String",
      "AllowedPattern": "^arn:aws:acm:eu-north-1:[0-9]{12}:certificate/[0-9a-f-]{36}$",
      "Description": "Only an ISSUED, properly DNS-validated certificate for intelligence.novapharmhealthcare.com"
    },
    "ProductionTaskDefinitionArn": {
      "Type": "String",
      "AllowedPattern": "^arn:aws:ecs:eu-north-1:[0-9]{12}:task-definition/[A-Za-z0-9_./-]+:[0-9]+$",
      "Description": "Reviewed standalone production task definition, not the staging smoke task"
    },
    "LogBucketName": {
      "Type": "String",
      "AllowedPattern": "^[a-z0-9][a-z0-9.-]{2,62}$",
      "Description": "Preapproved S3 ALB access-log bucket with same-region ALB delivery policy and retention"
    },
    "DesiredCount": {
      "Type": "Number",
      "Default": 2,
      "MinValue": 2,
      "MaxValue": 10,
      "Description": "Two production tasks in distinct subnets minimum; don't activate without operating budget"
    }
  },
  "Conditions": {
    "ActivateAfterApproval": {
      "Fn::Equals": [
        {
          "Ref": "ActivationApproval"
        },
        "APPROVED"
      ]
    }
  },
  "Resources": {
    "IntelligenceAlbSecurityGroup": {
      "Type": "AWS::EC2::SecurityGroup",
      "Condition": "ActivateAfterApproval",
      "Properties": {
        "GroupDescription": "Dedicated Intelligence HTTPS ALB, no http/80",
        "VpcId": {
          "Ref": "VpcId"
        },
        "SecurityGroupIngress": [
          {
            "IpProtocol": "tcp",
            "FromPort": 443,
            "ToPort": 443,
            "CidrIp": "0.0.0.0/0",
            "Description": "Public HTTPS only"
          }
        ],
        "SecurityGroupEgress": [
          {
            "IpProtocol": "tcp",
            "FromPort": 4303,
            "ToPort": 4303,
            "DestinationSecurityGroupId": {
              "Ref": "IntelligenceTaskSecurityGroup"
            },
            "Description": "Only the private Fargate portal"
          }
        ],
        "Tags": [
          {
            "Key": "application",
            "Value": "novapharm-intelligence"
          },
          {
            "Key": "release",
            "Value": "owner-approved"
          }
        ]
      }
    },
    "IntelligenceTaskSecurityGroup": {
      "Type": "AWS::EC2::SecurityGroup",
      "Condition": "ActivateAfterApproval",
      "Properties": {
        "GroupDescription": "Dedicated private Intelligence Fargate: ALB ingress only",
        "VpcId": {
          "Ref": "VpcId"
        },
        "SecurityGroupIngress": [
          {
            "IpProtocol": "tcp",
            "FromPort": 4303,
            "ToPort": 4303,
            "SourceSecurityGroupId": {
              "Ref": "IntelligenceAlbSecurityGroup"
            },
            "Description": "Dedicated ALB target traffic only"
          }
        ],
        "SecurityGroupEgress": [
          {
            "IpProtocol": "tcp",
            "FromPort": 443,
            "ToPort": 443,
            "CidrIp": "0.0.0.0/0",
            "Description": "TLS to approved external APIs via controlled egress/network, reviewed separately"
          }
        ],
        "Tags": [
          {
            "Key": "application",
            "Value": "novapharm-intelligence"
          },
          {
            "Key": "release",
            "Value": "owner-approved"
          }
        ]
      }
    },
    "IntelligenceAlb": {
      "Type": "AWS::ElasticLoadBalancingV2::LoadBalancer",
      "Condition": "ActivateAfterApproval",
      "Properties": {
        "Name": "novapharm-intelligence-live",
        "Type": "application",
        "Scheme": "internet-facing",
        "IpAddressType": "ipv4",
        "Subnets": {
          "Ref": "PublicSubnetIds"
        },
        "SecurityGroups": [
          {
            "Ref": "IntelligenceAlbSecurityGroup"
          }
        ],
        "LoadBalancerAttributes": [
          {
            "Key": "deletion_protection.enabled",
            "Value": "true"
          },
          {
            "Key": "routing.http.drop_invalid_header_fields.enabled",
            "Value": "true"
          },
          {
            "Key": "routing.http.desync_mitigation_mode",
            "Value": "strictest"
          },
          {
            "Key": "access_logs.s3.enabled",
            "Value": "true"
          },
          {
            "Key": "access_logs.s3.bucket",
            "Value": {
              "Ref": "LogBucketName"
            }
          },
          {
            "Key": "access_logs.s3.prefix",
            "Value": "intelligence"
          }
        ],
        "Tags": [
          {
            "Key": "application",
            "Value": "novapharm-intelligence"
          },
          {
            "Key": "owner",
            "Value": "novapharm"
          }
        ]
      }
    },
    "IntelligenceTargets": {
      "Type": "AWS::ElasticLoadBalancingV2::TargetGroup",
      "Condition": "ActivateAfterApproval",
      "Properties": {
        "Name": "novapharm-intelligence-4303",
        "VpcId": {
          "Ref": "VpcId"
        },
        "Protocol": "HTTP",
        "Port": 4303,
        "TargetType": "ip",
        "HealthCheckEnabled": true,
        "HealthCheckProtocol": "HTTP",
        "HealthCheckPath": "/",
        "HealthCheckIntervalSeconds": 30,
        "HealthCheckTimeoutSeconds": 5,
        "HealthyThresholdCount": 3,
        "UnhealthyThresholdCount": 2,
        "Matcher": {
          "HttpCode": "200-399"
        },
        "TargetGroupAttributes": [
          {
            "Key": "deregistration_delay.timeout_seconds",
            "Value": "30"
          }
        ]
      }
    },
    "IntelligenceHttpsListener": {
      "Type": "AWS::ElasticLoadBalancingV2::Listener",
      "Condition": "ActivateAfterApproval",
      "Properties": {
        "LoadBalancerArn": {
          "Ref": "IntelligenceAlb"
        },
        "Port": 443,
        "Protocol": "HTTPS",
        "SslPolicy": "ELBSecurityPolicy-TLS13-1-2-2021-06",
        "Certificates": [
          {
            "CertificateArn": {
              "Ref": "IssuedCertificateArn"
            }
          }
        ],
        "DefaultActions": [
          {
            "Type": "forward",
            "TargetGroupArn": {
              "Ref": "IntelligenceTargets"
            }
          }
        ]
      }
    },
    "IntelligenceWaf": {
      "Type": "AWS::WAFv2::WebACL",
      "Condition": "ActivateAfterApproval",
      "Properties": {
        "Name": "novapharm-intelligence-regional",
        "Scope": "REGIONAL",
        "DefaultAction": {
          "Allow": {}
        },
        "VisibilityConfig": {
          "CloudWatchMetricsEnabled": true,
          "MetricName": "novapharmIntelligenceWebACL",
          "SampledRequestsEnabled": false
        },
        "Rules": [
          {
            "Name": "AWSManagedRulesCommonRuleSet",
            "Priority": 0,
            "OverrideAction": {
              "None": {}
            },
            "Statement": {
              "ManagedRuleGroupStatement": {
                "VendorName": "AWS",
                "Name": "AWSManagedRulesCommonRuleSet"
              }
            },
            "VisibilityConfig": {
              "CloudWatchMetricsEnabled": true,
              "MetricName": "AWSManagedRulesCommonRuleSet",
              "SampledRequestsEnabled": false
            }
          },
          {
            "Name": "AWSManagedRulesAmazonIpReputationList",
            "Priority": 1,
            "OverrideAction": {
              "None": {}
            },
            "Statement": {
              "ManagedRuleGroupStatement": {
                "VendorName": "AWS",
                "Name": "AWSManagedRulesAmazonIpReputationList"
              }
            },
            "VisibilityConfig": {
              "CloudWatchMetricsEnabled": true,
              "MetricName": "AWSManagedRulesAmazonIpReputationList",
              "SampledRequestsEnabled": false
            }
          }
        ]
      }
    },
    "IntelligenceWafAssociation": {
      "Type": "AWS::WAFv2::WebACLAssociation",
      "Condition": "ActivateAfterApproval",
      "Properties": {
        "ResourceArn": {
          "Ref": "IntelligenceAlb"
        },
        "WebACLArn": {
          "Fn::GetAtt": [
            "IntelligenceWaf",
            "Arn"
          ]
        }
      }
    },
    "IntelligenceCluster": {
      "Type": "AWS::ECS::Cluster",
      "Condition": "ActivateAfterApproval",
      "Properties": {
        "ClusterName": "novapharm-intelligence-production",
        "ClusterSettings": [
          {
            "Name": "containerInsights",
            "Value": "enabled"
          }
        ],
        "Tags": [
          {
            "Key": "application",
            "Value": "novapharm-intelligence"
          },
          {
            "Key": "environment",
            "Value": "production"
          }
        ]
      }
    },
    "IntelligenceService": {
      "Type": "AWS::ECS::Service",
      "Condition": "ActivateAfterApproval",
      "DependsOn": [
        "IntelligenceHttpsListener"
      ],
      "Properties": {
        "ServiceName": "novapharm-intelligence-terminal",
        "Cluster": {
          "Ref": "IntelligenceCluster"
        },
        "TaskDefinition": {
          "Ref": "ProductionTaskDefinitionArn"
        },
        "LaunchType": "FARGATE",
        "PlatformVersion": "LATEST",
        "DesiredCount": {
          "Ref": "DesiredCount"
        },
        "EnableExecuteCommand": false,
        "EnableECSManagedTags": true,
        "PropagateTags": "SERVICE",
        "DeploymentConfiguration": {
          "DeploymentCircuitBreaker": {
            "Enable": true,
            "Rollback": true
          },
          "MaximumPercent": 200,
          "MinimumHealthyPercent": 100
        },
        "LoadBalancers": [
          {
            "ContainerName": "portal",
            "ContainerPort": 4303,
            "TargetGroupArn": {
              "Ref": "IntelligenceTargets"
            }
          }
        ],
        "NetworkConfiguration": {
          "AwsvpcConfiguration": {
            "AssignPublicIp": "DISABLED",
            "Subnets": {
              "Ref": "PrivateSubnetIds"
            },
            "SecurityGroups": [
              {
                "Ref": "IntelligenceTaskSecurityGroup"
              }
            ]
          }
        }
      }
    },
    "IntelligenceUnhealthyAlarm": {
      "Type": "AWS::CloudWatch::Alarm",
      "Condition": "ActivateAfterApproval",
      "Properties": {
        "AlarmDescription": "Dedicated Intelligence private portal unhealthy endpoints",
        "Namespace": "AWS/ApplicationELB",
        "MetricName": "UnHealthyHostCount",
        "Statistic": "Maximum",
        "Period": 60,
        "EvaluationPeriods": 2,
        "Threshold": 0,
        "ComparisonOperator": "GreaterThanThreshold",
        "TreatMissingData": "breaching",
        "Dimensions": [
          {
            "Name": "LoadBalancer",
            "Value": {
              "Fn::GetAtt": [
                "IntelligenceAlb",
                "LoadBalancerFullName"
              ]
            }
          },
          {
            "Name": "TargetGroup",
            "Value": {
              "Fn::GetAtt": [
                "IntelligenceTargets",
                "TargetGroupFullName"
              ]
            }
          }
        ]
      }
    }
  },
  "Outputs": {
    "ActivationState": {
      "Value": {
        "Fn::If": [
          "ActivateAfterApproval",
          "APPROVED infrastructure only; NOT proof of OIDC, data rights, NOVA or billing",
          "BLOCKED: no charge-bearing ingress/ECS resources created"
        ]
      }
    },
    "LoadBalancerDnsName": {
      "Condition": "ActivateAfterApproval",
      "Value": {
        "Fn::GetAtt": [
          "IntelligenceAlb",
          "DNSName"
        ]
      },
      "Description": "External DNS owner must add intelligence CNAME after ACM validation; this template never changes existing Nutraxin DNS"
    },
    "LoadBalancerArn": {
      "Condition": "ActivateAfterApproval",
      "Value": {
        "Ref": "IntelligenceAlb"
      }
    },
    "WafArn": {
      "Condition": "ActivateAfterApproval",
      "Value": {
        "Fn::GetAtt": [
          "IntelligenceWaf",
          "Arn"
        ]
      }
    }
  }
}
