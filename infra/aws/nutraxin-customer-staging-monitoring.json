{
  "AWSTemplateFormatVersion": "2010-09-09",
  "Description": "NovaPharm Nutraxin staging-only operational alarms. No customer onboarding, payment, DNS, or production activation. No email/pager route until monitored operations endpoint is approved.",
  "Resources": {
    "BackendErrorAlarm": {
      "Type": "AWS::CloudWatch::Alarm",
      "Properties": {
        "AlarmName": "novapharm-staging-nutraxin-lambda-errors",
        "AlarmDescription": "At least one Nutraxin customer staging Lambda execution error over five minutes",
        "Namespace": "AWS/Lambda",
        "MetricName": "Errors",
        "Dimensions": [
          {
            "Name": "FunctionName",
            "Value": "novapharm-staging-nutraxin-customer-bff"
          }
        ],
        "Statistic": "Sum",
        "Period": 300,
        "EvaluationPeriods": 1,
        "Threshold": 1,
        "ComparisonOperator": "GreaterThanOrEqualToThreshold",
        "TreatMissingData": "notBreaching",
        "ActionsEnabled": false
      }
    },
    "BackendThrottleAlarm": {
      "Type": "AWS::CloudWatch::Alarm",
      "Properties": {
        "AlarmName": "novapharm-staging-nutraxin-lambda-throttles",
        "AlarmDescription": "At least one Nutraxin customer staging Lambda throttle over five minutes",
        "Namespace": "AWS/Lambda",
        "MetricName": "Throttles",
        "Dimensions": [
          {
            "Name": "FunctionName",
            "Value": "novapharm-staging-nutraxin-customer-bff"
          }
        ],
        "Statistic": "Sum",
        "Period": 300,
        "EvaluationPeriods": 1,
        "Threshold": 1,
        "ComparisonOperator": "GreaterThanOrEqualToThreshold",
        "TreatMissingData": "notBreaching",
        "ActionsEnabled": false
      }
    },
    "HttpApi5xxAlarm": {
      "Type": "AWS::CloudWatch::Alarm",
      "Properties": {
        "AlarmName": "novapharm-staging-nutraxin-api-5xx",
        "AlarmDescription": "At least two 5xx responses at Nutraxin customer staging HTTP API over five minutes",
        "Namespace": "AWS/ApiGateway",
        "MetricName": "5xx",
        "Dimensions": [
          {
            "Name": "ApiId",
            "Value": "wgy9p7ad0d"
          },
          {
            "Name": "Stage",
            "Value": "$default"
          }
        ],
        "Statistic": "Sum",
        "Period": 300,
        "EvaluationPeriods": 1,
        "Threshold": 2,
        "ComparisonOperator": "GreaterThanOrEqualToThreshold",
        "TreatMissingData": "notBreaching",
        "ActionsEnabled": false
      }
    }
  },
  "Outputs": {
    "StageOnly": {
      "Value": "Customer portal staging monitoring only; no automatic notification recipient or production traffic"
    }
  }
}
