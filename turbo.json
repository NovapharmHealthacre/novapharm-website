{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "typecheck": {
      "cache": true,
      "outputs": []
    },
    "test": {
      "dependsOn": ["typecheck"],
      "cache": true,
      "outputs": []
    },
    "build": {
      "dependsOn": ["^build"],
      "outputs": [".next/**", "dist/**", "!.next/cache/**"]
    }
  }
}
