{
  "$schema": "https://novapharmhealthcare.com/design-system/tokens/v2.0.json",
  "meta": {
    "name": "NovaPharm Shared Design Language",
    "version": "2.0.0",
    "date": "2026-11-02",
    "platforms": ["web", "ios-swiftui", "android-sdk35"],
    "accessibilityTarget": "WCAG 2.2 AA + Apple HIG Dynamic Type/VoiceOver + Android TalkBack/48dp",
    "liquidGlassRule": "Navigation bars, command palette, and floating controls only. Never fill primary medicine or evidence reading cards with translucent glass."
  },
  "color": {
    "light": {
      "canvas": "#F7F7F5",
      "surfacePrimary": "#FFFFFF",
      "surfaceSecondary": "#F2F4F7",
      "surfaceTertiary": "#EAECEF",
      "glassNav": "rgba(255, 255, 255, 0.84)",
      "textPrimary": "#111318",
      "textSecondary": "#3E4552",
      "textMuted": "#5E6675",
      "borderSubtle": "#E3E6EC",
      "borderStrong": "#C8CFD9",
      "brandRed": "#C8102E",
      "brandRedHover": "#A50C25",
      "brandRedSubtle": "rgba(200, 16, 46, 0.08)",
      "statusObserved": "#1D4ED8",
      "statusDerived": "#0F766E",
      "statusForecast": "#4338CA",
      "statusAssumption": "#B45309",
      "statusRecommendation": "#9333EA",
      "statusPrediction": "#6D28D9",
      "statusVerified": "#047857",
      "statusUnavailable": "#475569",
      "statusBlocked": "#B91C1C"
    },
    "dark": {
      "canvas": "#0B0E14",
      "surfacePrimary": "#121722",
      "surfaceSecondary": "#171E2C",
      "surfaceTertiary": "#1E2738",
      "glassNav": "rgba(18, 23, 34, 0.82)",
      "textPrimary": "#F3F5F8",
      "textSecondary": "#C4CBD8",
      "textMuted": "#8E98AA",
      "borderSubtle": "rgba(148, 163, 184, 0.16)",
      "borderStrong": "rgba(148, 163, 184, 0.30)",
      "brandRed": "#E52545",
      "brandRedHover": "#F43F5E",
      "brandRedSubtle": "rgba(229, 37, 69, 0.15)",
      "statusObserved": "#60A5FA",
      "statusDerived": "#2DD4BF",
      "statusForecast": "#818CF8",
      "statusAssumption": "#FBBF24",
      "statusRecommendation": "#C084FC",
      "statusPrediction": "#A78BFA",
      "statusVerified": "#34D399",
      "statusUnavailable": "#94A3B8",
      "statusBlocked": "#F87171"
    }
  },
  "typography": {
    "fontFamilySans": {
      "web": "-apple-system, BlinkMacSystemFont, 'SF Pro Text', 'SF Pro Display', 'Segoe UI', Roboto, Helvetica, Arial, sans-serif",
      "ios": "System SF Pro (.default)",
      "android": "sans-serif / sans-serif-medium (Roboto system metrics)"
    },
    "fontFamilyMono": {
      "web": "ui-monospace, 'SF Mono', SFMono-Regular, Menlo, Consolas, monospace",
      "ios": "System SF Mono (.monospaced)",
      "android": "monospace"
    },
    "scalePx": {
      "xs": 12,
      "sm": 13,
      "base": 15,
      "md": 17,
      "lg": 20,
      "xl": 26,
      "2xl": 32
    }
  },
  "spacingPx": {
    "1": 4,
    "2": 8,
    "3": 12,
    "4": 16,
    "5": 20,
    "6": 24,
    "8": 32,
    "10": 40,
    "12": 48
  },
  "radiiPx": {
    "sm": 8,
    "md": 12,
    "lg": 16,
    "xl": 20,
    "pill": 999
  },
  "motion": {
    "durationFastMs": 120,
    "durationNormalMs": 180,
    "easingStandard": "cubic-bezier(0.2, 0.0, 0.0, 1.0)",
    "reducedMotion": "0ms"
  },
  "touchTargets": {
    "webMinimumPx": 40,
    "iosMinimumPt": 44,
    "androidMinimumDp": 48
  }
}
